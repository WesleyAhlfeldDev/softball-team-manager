# ─────────────────────────────────────────────────────────────
# Copy to .env.local and fill in. Never commit real secrets.
# ─────────────────────────────────────────────────────────────

# Postgres connection (Prisma). Required to run migrations and the app.
DATABASE_URL="postgresql://user:password@host:5432/dbname"
# Unpooled/direct connection used by Prisma migrations (can equal DATABASE_URL).
DATABASE_URL_UNPOOLED="postgresql://user:password@host:5432/dbname"

# NextAuth / Auth.js. Generate with:  npx auth secret
AUTH_SECRET=""

# Set to "true" to open public self-serve signup. Leave unset/closed for now.
ALLOW_SIGNUPS="false"

# Google OAuth — https://console.cloud.google.com (OAuth client)
# Redirect URI: <origin>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Facebook OAuth — https://developers.facebook.com (Facebook Login)
# Redirect URI: <origin>/api/auth/callback/facebook
AUTH_FACEBOOK_ID=""
AUTH_FACEBOOK_SECRET=""
